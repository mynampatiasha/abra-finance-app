        doc.text(`Place of Supply: ${credit.placeOfSupply}`, detX + 8, metaY + 39, { width: colW - 16 });
      }

      let tableStartY = metaY + metaH + 12;

      // -- ITEMS TABLE -------------------------------------------------------
      const isInterState = credit.isInterState;
      const cols = {
        num:     { x: 40,  w: 16  },
        desc:    { x: 56,  w: 90  },
        hsn:     { x: 146, w: 44  },
        unit:    { x: 190, w: 24  },
        qty:     { x: 214, w: 24  },
        rate:    { x: 238, w: 36  },
        disc:    { x: 274, w: 26  },
        taxable: { x: 300, w: 38  },
        gst:     { x: 338, w: 24  },
        tax1:    { x: 362, w: 46  },
        tax2:    { x: 408, w: 46  },
        amount:  { x: 454, w: 61  },
      };

      doc.rect(40, tableStartY, 515, 20).fill('#0f1e3d');
      doc.fontSize(7).fillColor('#ffffff').font('Helvetica-Bold');
      doc.text('#',        cols.num.x  + 2, tableStartY + 7, { width: cols.num.w });
      doc.text('ITEM',     cols.desc.x + 2, tableStartY + 7, { width: cols.desc.w });
      doc.text('HSN/SAC',  cols.hsn.x  + 2, tableStartY + 7, { width: cols.hsn.w });
      doc.text('UNIT',     cols.unit.x + 2, tableStartY + 7, { width: cols.unit.w });
      doc.text('QTY',      cols.qty.x  + 2, tableStartY + 7, { width: cols.qty.w,     align: 'center' });
      doc.text('RATE',     cols.rate.x + 2, tableStartY + 7, { width: cols.rate.w,    align: 'right' });
      doc.text('DISC',     cols.disc.x + 2, tableStartY + 7, { width: cols.disc.w,    align: 'right' });
      doc.text('TAXABLE',  cols.taxable.x+2,tableStartY + 7, { width: cols.taxable.w, align: 'right' });
      doc.text('GST%',     cols.gst.x  + 2, tableStartY + 7, { width: cols.gst.w,     align: 'center' });
      if (isInterState) {
        doc.text('IGST',   cols.tax1.x + 2, tableStartY + 7, { width: cols.tax1.w + cols.tax2.w, align: 'right' });
      } else {
        doc.text('CGST',   cols.tax1.x + 2, tableStartY + 7, { width: cols.tax1.w, align: 'right' });
        doc.text('SGST',   cols.tax2.x + 2, tableStartY + 7, { width: cols.tax2.w, align: 'right' });
      }
      doc.text('AMOUNT',   cols.amount.x+2, tableStartY + 7, { width: cols.amount.w,  align: 'right' });

      let rowY = tableStartY + 20;
      (credit.items || []).forEach((item, idx) => {
        const descText  = item.itemDetails || 'N/A';
        const descWidth = cols.desc.w - 4;
        const vPad      = 8;
        doc.font('Helvetica').fontSize(7);
        const descH = doc.heightOfString(descText, { width: descWidth, lineGap: 1 });
        const rowH  = Math.max(20, descH + vPad * 2);
        const fill  = idx % 2 === 0 ? '#ffffff' : '#f7f9fc';
        doc.rect(40, rowY, 515, rowH).fill(fill);
        doc.rect(40, rowY, 515, rowH).lineWidth(0.5).strokeColor('#dde4ef').stroke();

        const cellY   = rowY + vPad;
        const hsnSac  = item.hsnCode || item.sacCode || '';
        const discStr = item.discount > 0
          ? (item.discountType === 'percentage' ? `${item.discount}%` : `${item.discount}`)
          : '�';

        doc.fontSize(7).fillColor('#000000');
        doc.font('Helvetica-Bold').text(String(idx + 1), cols.num.x + 2, cellY, { width: cols.num.w });
        doc.font('Helvetica').text(descText, cols.desc.x + 2, cellY, { width: descWidth, lineGap: 1 });
        doc.text(hsnSac,                               cols.hsn.x  + 2, cellY, { width: cols.hsn.w - 2,  ellipsis: true });
        doc.text(item.unit || 'Nos',                   cols.unit.x + 2, cellY, { width: cols.unit.w });
        doc.text(String(item.quantity || 0),           cols.qty.x  + 2, cellY, { width: cols.qty.w,     align: 'center' });
        doc.text(`${(item.rate || 0).toFixed(2)}`,     cols.rate.x + 2, cellY, { width: cols.rate.w,    align: 'right' });
        doc.text(discStr,                              cols.disc.x + 2, cellY, { width: cols.disc.w,    align: 'right' });
        doc.text(`${(item.taxableAmount || 0).toFixed(2)}`, cols.taxable.x + 2, cellY, { width: cols.taxable.w, align: 'right' });
        doc.text(`${item.itemGstRate || 0}%`,          cols.gst.x  + 2, cellY, { width: cols.gst.w,     align: 'center' });
        if (isInterState) {
          doc.text(`${(item.igstAmount || 0).toFixed(2)}`, cols.tax1.x + 2, cellY, { width: cols.tax1.w + cols.tax2.w, align: 'right' });
        } else {
          doc.text(`${(item.cgstAmount || 0).toFixed(2)}`, cols.tax1.x + 2, cellY, { width: cols.tax1.w, align: 'right' });
          doc.text(`${(item.sgstAmount || 0).toFixed(2)}`, cols.tax2.x + 2, cellY, { width: cols.tax2.w, align: 'right' });
        }
        doc.font('Helvetica-Bold').text(`${(item.amount || 0).toFixed(2)}`, cols.amount.x + 2, cellY, { width: cols.amount.w, align: 'right' });
        rowY += rowH;
      });

      // -- TOTALS ------------------------------------------------------------
      const totalsX = 315;
      const totalsW = 240;
      let totalsY   = rowY + 12;
      const summaryY = totalsY;
      const amountX  = totalsX + totalsW;

      const tRow = (label, amount, bold = false) => {
        doc.fontSize(8).fillColor('#5e6e84').font(bold ? 'Helvetica-Bold' : 'Helvetica')
           .text(label, totalsX, totalsY, { width: 140 });
        doc.fillColor('#000000').font(bold ? 'Helvetica-Bold' : 'Helvetica')
           .text(amount, totalsX + 140, totalsY, { width: 100, align: 'right' });
        doc.moveTo(totalsX, totalsY + 11).lineTo(amountX, totalsY + 11)
           .lineWidth(0.5).strokeColor('#dde4ef').dash(2, { space: 2 }).stroke().undash();
        totalsY += 14;
      };

      tRow('Subtotal:', `Rs. ${(credit.subTotal || 0).toFixed(2)}`);
      if (isInterState) {
        if ((credit.totalIGST || 0) > 0) tRow('IGST:', `Rs. ${credit.totalIGST.toFixed(2)}`);
      } else {
        if ((credit.totalCGST || 0) > 0) tRow('CGST:', `Rs. ${credit.totalCGST.toFixed(2)}`);
        if ((credit.totalSGST || 0) > 0) tRow('SGST:', `Rs. ${credit.totalSGST.toFixed(2)}`);
      }
      if ((credit.tdsAmount || 0) > 0) tRow('TDS Deducted:', `- Rs. ${credit.tdsAmount.toFixed(2)}`);
      if ((credit.tcsAmount || 0) > 0) tRow('TCS Collected:', `Rs. ${credit.tcsAmount.toFixed(2)}`);

      totalsY += 4;
      doc.rect(totalsX, totalsY, totalsW, 24).fill('#0f1e3d');
      doc.fontSize(8).fillColor('rgba(255,255,255,0.75)').font('Helvetica').text('Credit Amount', totalsX + 6, totalsY + 7);
      doc.fontSize(13).fillColor('#ffffff').font('Helvetica-Bold')
         .text(`Rs. ${(credit.totalAmount || 0).toFixed(2)}`, totalsX, totalsY + 5, { width: totalsW - 6, align: 'right' });
      totalsY += 32;

      if ((credit.balanceAmount || 0) > 0) {
        tRow('Applied:', `Rs. ${(credit.appliedAmount || 0).toFixed(2)}`);
        tRow('Balance:', `Rs. ${credit.balanceAmount.toFixed(2)}`, true);
      }

      // Amount in words
      const wordsY = Math.max(summaryY, totalsY) + 8;
      doc.rect(40, wordsY, pageW, 18).fill('#f0fdf4');
      doc.fontSize(7.5).fillColor('#065f46').font('Helvetica-Bold')
         .text(`In Words: ${numberToWords(Math.round(credit.totalAmount || 0))} Only`, 48, wordsY + 5, { width: pageW - 16 });

      // Notes
      let notesY = wordsY + 28;
      if (credit.notes) {
        doc.fontSize(7.5).fillColor('#8a9ab5').font('Helvetica-Bold').text('NOTES', 40, notesY, { characterSpacing: 0.8 });
        doc.moveTo(40, notesY + 9).lineTo(555, notesY + 9).lineWidth(0.5).strokeColor('#dde4ef').stroke();
        doc.fontSize(8).fillColor('#000000').font('Helvetica').text(credit.notes, 40, notesY + 14, { width: pageW });
        notesY += 40;
      }

      // Authorized signatory
      const signSectionY = notesY + 10;
      const signBoxW     = 220;
      const authBoxX     = 555 - signBoxW;
      doc.fontSize(7).fillColor('#8a9ab5').font('Helvetica-Bold')
         .text(`For ${orgName.toUpperCase()}`, authBoxX, signSectionY, { width: signBoxW, characterSpacing: 0.5, ellipsis: true });

      const _vcSigRelPath = orgData?.digitalSignaturePath;
      const _vcSigSize    = 200;
      let   _vcActualSigH = _vcSigSize;
      if (_vcSigRelPath) {
        try {
          const _vcSigAbs = path.join(__dirname, '..', _vcSigRelPath.replace(/^\//, ''));
          if (fs.existsSync(_vcSigAbs)) {
            let _vcW = _vcSigSize, _vcH = _vcSigSize;
            try {
              const _vcBuf = fs.readFileSync(_vcSigAbs);
              const _vcExt = path.extname(_vcSigAbs).toLowerCase();
              if (_vcExt === '.png' && _vcBuf.length > 24) { _vcW = _vcBuf.readUInt32BE(16); _vcH = _vcBuf.readUInt32BE(20); }
              else if ((_vcExt === '.jpg' || _vcExt === '.jpeg') && _vcBuf.length > 4) {
                let _vci = 2;
                while (_vci < _vcBuf.length - 8) {
                  if (_vcBuf[_vci] === 0xFF && _vcBuf[_vci+1] >= 0xC0 && _vcBuf[_vci+1] <= 0xC3) { _vcH = _vcBuf.readUInt16BE(_vci+5); _vcW = _vcBuf.readUInt16BE(_vci+7); break; }
                  _vci += 2 + _vcBuf.readUInt16BE(_vci + 2);
                }
              }
            } catch (_) {}
            const _vcScale = Math.min(_vcSigSize / _vcW, _vcSigSize / _vcH);
            _vcActualSigH  = Math.round(_vcH * _vcScale);
            const _vcActualSigW = Math.round(_vcW * _vcScale);
            doc.image(_vcSigAbs, authBoxX + (signBoxW - _vcActualSigW) / 2, signSectionY + 10, { width: _vcActualSigW, height: _vcActualSigH });
          }
        } catch (_e) { console.warn('⚠️ Signature render failed:', _e.message); }
      }

      const _vcSigLineY = signSectionY + 10 + _vcActualSigH + 14;
      doc.moveTo(authBoxX, _vcSigLineY).lineTo(authBoxX + signBoxW, _vcSigLineY)
         .lineWidth(0.5).strokeColor('#aaaaaa').stroke();
      doc.fontSize(6.5).fillColor('#000000').font('Helvetica-Bold')
         .text('Authorized Signatory', authBoxX, _vcSigLineY + 3, { width: signBoxW, align: 'center' });

      // Footer
      const footY = 760;
      doc.moveTo(40, footY).lineTo(555, footY).lineWidth(1.5).strokeColor('#dde4ef').stroke();
      doc.fontSize(7).fillColor('#8a9ab5').font('Helvetica')
         .text(`${orgName} � ${orgGST ? 'GSTIN: ' + orgGST + ' � ' : ''}${credit.creditNumber}`, 40, footY + 6, { width: pageW / 2 });
      doc.text(`Generated on ${new Date().toLocaleDateString('en-IN')}`, 40, footY + 6, { width: pageW, align: 'right' });

      doc.end();
      stream.on('finish', () => {
        console.log(`? Vendor Credit PDF generated: ${filename} | Logo: ${logoLoaded ? 'YES' : 'NO'}`);
        resolve({ filename, filepath });
      });
      stream.on('error', reject);
    } catch (err) {
      reject(err);
    }
  });
};

