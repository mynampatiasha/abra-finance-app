const VendorCreditSchema = new mongoose.Schema({
  orgId:        { type: String, index: true, default: null },
  branchId:     { type: String, index: true, default: null },
  creditNumber: { type: String, sparse: true },
  vendorId:     { type: String, required: true },
  vendorName:   { type: String, required: true },
  vendorEmail:  { type: String, default: '' },
  vendorPhone:  { type: String, trim: true, default: '' },
  vendorGSTIN:  { type: String, default: '' },
  vendorPAN:    { type: String, default: '' },
  gstRegistrationType: { type: String, default: '' },
  // Addresses
  billingAddress:  { type: VendorAddressSchema, default: () => ({}) },
  shippingAddress: { type: VendorAddressSchema, default: () => ({}) },
  // Place of supply / GST routing
  placeOfSupply: { type: String, default: '' },
  sourceState:   { type: String, default: '' },
  isInterState:  { type: Boolean, default: false },
  creditDate:   { type: Date, required: true, default: Date.now },
  billId:       { type: String, default: null },
  billNumber:   { type: String, default: null },
  reason:       { type: String, required: true },
  status: {
