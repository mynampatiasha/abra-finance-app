          repeatEvery:    p.repeatEvery,
          repeatUnit:     p.repeatUnit,
          status:         p.status,
          nextBillDate:   p.nextBillDate,
          lastBillDate:   p.lastBillDate,
          billsGenerated: p.generatedBills?.length || 0,
        }))
      }
    });
  } catch (e) { res.status(500).json({ success: false, message: e.message }); }
});

