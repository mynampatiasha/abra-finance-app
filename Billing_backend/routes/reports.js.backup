// ── SECTION 4: PAYMENTS RECEIVED (4 reports) ─────────────────────────────────
// ============================================================================

// 4.1  Payments Received — reads from payments_received collection directly
router.get('/payments-received', async (req, res) => {
  try {
    const { start, end } = parseDateRange(req.query);
    const scope = orgScope(req);

    // Use the raw MongoDB driver to hit payments_received collection
    // (same collection used by payments-received.js route)
    const db = getDB(req);

    const payments = await db.collection('payments_received')
      .find({ ...scope, status: { $ne: 'void' } })
      .sort({ createdAt: -1 })
      .limit(1000)
      .toArray();

    // Filter by date range — handles all 3 date storage formats
    const filtered = payments.filter(p => {
      const raw = p.paymentDate;
      if (!raw) return false;
      let d;
      if (raw instanceof Date) {
        d = raw;
      } else if (typeof raw === 'string') {
        if (raw.includes('/')) {
          // DD/MM/YYYY
          const [day, month, year] = raw.split('/');
          d = new Date(`${year}-${month.padStart(2, '0')}-${day.padStart(2, '0')}`);
        } else {
          d = new Date(raw);
        }
      } else {
        d = new Date(raw);
      }
      if (isNaN(d)) return false;
      return d >= start && d <= end;
    });

    const rows = filtered.map(p => ({
      paymentNumber:  p.paymentNumber,
      paymentDate:    p.paymentDate,
      customerName:   p.customerName,
      customerEmail:  p.customerEmail,
      amount:         fmt(p.amountReceived || 0),
      bankCharges:    fmt(p.bankCharges || 0),
      netAmount:      fmt(p.netAmount || 0),
      paymentMode:    p.paymentMode,
      depositTo:      p.depositTo,
      reference:      p.reference || '',
      taxDeduction:   p.taxDeduction || '',
      status:         p.status || 'paid',
      hasProofs:      (p.paymentProofs || []).length > 0,
      notes:          p.notes || '',
    }));

    res.json({
      success: true,
      data: {
        period: { start, end },
        payments: rows,
        totals: {
          count:       rows.length,
          total:       fmt(rows.reduce((s, r) => s + parseFloat(r.amount || 0), 0)),
          bankCharges: fmt(rows.reduce((s, r) => s + parseFloat(r.bankCharges || 0), 0)),
          netAmount:   fmt(rows.reduce((s, r) => s + parseFloat(r.netAmount || 0), 0)),
        },
      }
    });
  } catch (e) { res.status(500).json({ success: false, message: e.message }); }
});

// 4.2  Time to Get Paid
router.get('/time-to-get-paid', async (req, res) => {
  try {
    const { start, end } = parseDateRange(req.query);
    const scope = orgScope(req);
    const Invoice = col('Invoice', 'invoices');

    const invoices = await Invoice.find({
      status: 'PAID',
      'payments.0': { $exists: true },
      invoiceDate: { $gte: start, $lte: end },
      ...scope
    }).lean();

    const rows = invoices.map(inv => {
      const firstPayment = inv.payments?.[0];
      const days = firstPayment
        ? Math.floor((new Date(firstPayment.paymentDate || firstPayment.recordedAt) - new Date(inv.invoiceDate)) / 86400000)
        : null;
      return {
        invoiceNumber: inv.invoiceNumber,
        customerName:  inv.customerName,
        invoiceDate:   inv.invoiceDate,
        paymentDate:   firstPayment?.paymentDate || firstPayment?.recordedAt,
        daysToGetPaid: days,
        totalAmount:   fmt(inv.totalAmount),
      };
    }).filter(r => r.daysToGetPaid !== null && r.daysToGetPaid >= 0);

    const avgDays = rows.length > 0
      ? fmt(rows.reduce((s, r) => s + r.daysToGetPaid, 0) / rows.length)
      : 0;

    res.json({ success: true, data: { period: { start, end }, invoices: rows, averageDaysToGetPaid: avgDays } });
  } catch (e) { res.status(500).json({ success: false, message: e.message }); }
});

// 4.3  Refund History
router.get('/refund-history', async (req, res) => {
  try {
    const { start, end } = parseDateRange(req.query);
    const scope = orgScope(req);
    const CreditNote = col('CreditNote', 'creditnotes');
    const notes = await CreditNote.find({ 'refunds.0': { $exists: true }, ...scope }).lean();
    const refunds = [];
    for (const cn of notes) {
      for (const r of (cn.refunds || [])) {
        const rd = new Date(r.refundDate);
        if (rd >= start && rd <= end)
          refunds.push({
            creditNoteNumber: cn.creditNoteNumber,
            customerName:     cn.customerName,
            refundDate:       rd,
            amount:           fmt(r.amount),
            refundMethod:     r.refundMethod,
          });
      }
    }
    res.json({
      success: true,
      data: { period: { start, end }, refunds, total: fmt(refunds.reduce((s, r) => s + r.amount, 0)) }
    });
  } catch (e) { res.status(500).json({ success: false, message: e.message }); }
});

