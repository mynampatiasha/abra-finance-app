// ============================================================================
// ACCOUNT DETAIL PAGE — FIXED
// ============================================================================
// File: lib/screens/banking/account_detail_page.dart
//
// FIXES:
//   ✅ FIX 1: Right panel anchors to TOP of page — not middle
//   ✅ FIX 2: Category forms embedded INSIDE 40% panel (no Navigator.push)
//   ✅ FIX 3: Per-category fields: Expense Account+Date+Amount+Customer(opt)
//             Vendor Payment: Vendor+Amount+Date+Ref
//             Customer Payment: Customer+Amount+Date+Ref
//             Transfer: To/From Account
//             Simple: Amount+Notes
//   ✅ FIX 4: Paid Through auto-set to current account (hidden in panel)
//   ✅ FIX 5: All Transactions tab NO LONGER triggers reconciliation
//   ✅ FIX 6: Reconcile is a separate button, not tab index 2
// ============================================================================

import 'package:flutter/material.dart';
import 'package:intl/intl.dart';
import '../../../core/services/bank_transaction_service.dart';
import '../../../core/services/add_account_service.dart';
import '../../../core/services/expenses_service.dart';
import 'reconciliation_billing.dart';
import 'transaction_rules_screen.dart';
import 'bulk_import_bank_statement_dialog.dart';
import 'record_deposit_dialog.dart';
import 'manual_entry_dialog.dart';

// ─── colours ─────────────────────────────────────────────────────────────────
const Color _navyDark   = Color(0xFF0D1B3E);
const Color _navy       = Color(0xFF1e3a8a);
const Color _navyAccent = Color(0xFF3D8EFF);
const Color _green      = Color(0xFF27AE60);
const Color _blue       = Color(0xFF2980B9);
const Color _orange     = Color(0xFFE67E22);
const Color _red        = Color(0xFFE74C3C);
const Color _purple     = Color(0xFF9B59B6);
const Color _teal       = Color(0xFF16A085);

// ─── category model ──────────────────────────────────────────────────────────
class _Cat {
  final String id, label, group;
  final IconData icon;
  final Color color;
  const _Cat(this.id, this.label, this.group, this.icon, this.color);
}

const _moneyIn = [
  _Cat('customer_payment',      'Customer Payment',              'money_in', Icons.payments_outlined,        _green),
  _Cat('customer_advance',      'Customer Advance',              'money_in', Icons.person_add_outlined,      _green),
  _Cat('transfer_in',           'Transfer From Another Account', 'money_in', Icons.compare_arrows,           _blue),
  _Cat('interest_income',       'Interest Income',               'money_in', Icons.trending_up,              _teal),
  _Cat('other_income',          'Other Income',                  'money_in', Icons.add_circle_outline,       _teal),
  _Cat('expense_refund',        'Expense Refund',                'money_in', Icons.reply_outlined,           _green),
  _Cat('owner_contribution',    "Owner's Contribution",          'money_in', Icons.business_center_outlined, _navy),
  _Cat('vendor_credit_refund',  'Vendor Credit Refund',          'money_in', Icons.undo_outlined,            _green),
  _Cat('vendor_payment_refund', 'Vendor Payment Refund',         'money_in', Icons.reply_all_outlined,       _orange),
];

const _moneyOut = [
  _Cat('expense',            'Expense',                      'money_out', Icons.receipt_outlined,      _red),
  _Cat('vendor_advance',     'Vendor Advance',               'money_out', Icons.person_outlined,       _orange),
  _Cat('vendor_payment',     'Vendor Payment',               'money_out', Icons.payments_outlined,     _orange),
  _Cat('transfer_out',       'Transfer To Another Account',  'money_out', Icons.compare_arrows,        _blue),
  _Cat('card_payment',       'Card Payment',                 'money_out', Icons.credit_card_outlined,  _purple),
  _Cat('owner_drawings',     'Owner Drawings',               'money_out', Icons.person_pin_outlined,   _teal),
  _Cat('credit_note_refund', 'Credit Note Refund',           'money_out', Icons.undo_outlined,         _red),
  _Cat('payment_refund',     'Payment Refund',               'money_out', Icons.reply_outlined,        _orange),
];

// =============================================================================
//  PAGE
// =============================================================================

class AccountDetailPage extends StatefulWidget {
  final String  accountId;
  final String  accountName;
  final String  accountType;
  final String? accountNumber;
  final int     initialTab;

  const AccountDetailPage({
    Key? key,
    required this.accountId,
    required this.accountName,
    required this.accountType,
    this.accountNumber,
    this.initialTab = 0,
  }) : super(key: key);

  @override
  State<AccountDetailPage> createState() => _AccountDetailPageState();
}

class _AccountDetailPageState extends State<AccountDetailPage>
    with SingleTickerProviderStateMixin {

  final BankTransactionService _svc = BankTransactionService();

  // ✅ FIX 5: Only 2 tabs now — Dashboard + Uncategorized + All Transactions
  //           Reconcile is a button, NOT a tab
  late TabController _tabCtrl;

  // Stats
  int    _uncatCount   = 0;
  int    _catCount     = 0;
  int    _total        = 0;
  double _balance      = 0;
  bool   _statsLoading = true;

  // Transactions
  List<Map<String,dynamic>> _txns    = [];
  List<Map<String,dynamic>> _allTxns = [];
  bool _txnsLoading = true;

  // Filter
  String _filter = 'All';

  // Multi-select
  bool        _multiSelect = false;
  Set<String> _selectedIds = {};

  // Panel
  Map<String,dynamic>? _selectedTxn;
  bool _panelOpen = false;
  int  _panelTab  = 0; // 0=Match 1=Categorize

  // Match
  List<Map<String,dynamic>> _matches      = [];
  bool                      _matchLoading = false;

  // Categorize
  _Cat?   _selectedCat;
  bool    _catDropOpen = false;
  String? _catSearch;
  bool    _panelSaving = false;

  // ── Panel form controllers ────────────────────────────────────────────────
  final _panelNotesCtrl  = TextEditingController();
  final _panelRefCtrl    = TextEditingController();

  // Support data
  List<Map<String,dynamic>> _bankAccounts   = [];
  List<Map<String,dynamic>> _vendors        = [];
  List<Map<String,dynamic>> _customers      = [];
  List<COAOption>           _expCOAs        = [];

  // Panel dropdown selections
  Map<String,dynamic>? _selectedToAccount;
  Map<String,dynamic>? _selectedVendor;
  Map<String,dynamic>? _selectedCustomer;
  String?              _selectedExpenseAccount;

  // Vendor/Customer search in panel
  String _vendorSearch   = '';
  String _customerSearch = '';

  @override
  void initState() {
    super.initState();
    // ✅ FIX 5: 3 tabs — Dashboard | Uncategorized | All Transactions
    _tabCtrl = TabController(
        length: 3, vsync: this, initialIndex: widget.initialTab);
    // NO reconcile listener here — reconcile is a button
    _tabCtrl.addListener(() => setState(() {}));
    _loadAll();
  }

  @override
  void dispose() {
    _tabCtrl.dispose();
    _panelNotesCtrl.dispose();
    _panelRefCtrl.dispose();
    super.dispose();
  }

  Future<void> _loadAll() async {
    await Future.wait([_loadStats(), _loadTxns(), _loadSupport()]);
  }

  Future<void> _loadStats() async {
    setState(() => _statsLoading = true);
    try {
      final r = await _svc.getStats(widget.accountId);
      if (r['success'] == true) {
        final d = r['data'];
        setState(() {
          _uncatCount   = d['uncategorized'] ?? 0;
          _catCount     = d['categorized']   ?? 0;
          _total        = d['total']          ?? 0;
          _balance      = (d['currentBalance'] ?? 0).toDouble();
          _statsLoading = false;
        });
      }
    } catch (_) { setState(() => _statsLoading = false); }
  }

  Future<void> _loadTxns() async {
    setState(() => _txnsLoading = true);
    try {
      final r  = await _svc.getUncategorized(accountId: widget.accountId, page: 1, limit: 200);
      final r2 = await _svc.getAllTransactions(accountId: widget.accountId);
      setState(() {
        if (r['success']  == true) _txns    = List<Map<String,dynamic>>.from(r['data']  ?? []);
        if (r2['success'] == true) _allTxns = List<Map<String,dynamic>>.from(r2['data'] ?? []);
        _txnsLoading = false;
      });
    } catch (_) { setState(() => _txnsLoading = false); }
  }

  Future<void> _loadSupport() async {
    try {
      _expCOAs = await _svc.getCOAOptions('expense');
      final all = await AddAccountService().getAllAccounts();
      setState(() {
        _bankAccounts = all
            .where((a) => a['_id'] != widget.accountId && (a['isActive'] ?? true))
            .map((a) => Map<String,dynamic>.from(a)).toList();
      });
      // Load vendors
      try {
        final vr = await _svc.getVendors();
        if (vr['success'] == true) {
          setState(() => _vendors = List<Map<String,dynamic>>.from(
              vr['data'] ?? vr['vendors'] ?? []));
        }
      } catch (_) {}
      // Load customers
      try {
        final cr = await _svc.getCustomers();
        if (cr['success'] == true) {
          setState(() => _customers = List<Map<String,dynamic>>.from(
              cr['data'] ?? cr['customers'] ?? []));
        }
      } catch (_) {}
    } catch (_) {}
  }

  List<Map<String,dynamic>> get _filtered {
    switch (_filter) {
      case 'Recognized': return _txns.where((t) => t['isRecognized'] == true).toList();
      case 'Excluded':   return _txns.where((t) => t['isExcluded']   == true).toList();
      default:           return _txns;
    }
  }

  void _openPanel(Map<String,dynamic> txn, {int tab = 0}) {
    setState(() {
      _selectedTxn         = txn;
      _panelOpen           = true;
      _panelTab            = tab;
      _selectedCat         = null;
      _catDropOpen         = false;
      _catSearch           = null;
      _selectedToAccount   = null;
      _selectedVendor      = null;
      _selectedCustomer    = null;
      _selectedExpenseAccount = null;
      _panelSaving         = false;
      _vendorSearch        = '';
      _customerSearch      = '';
      _panelNotesCtrl.clear();
      _panelRefCtrl.text   = txn['referenceNumber']?.toString() ?? '';
    });
    if (tab == 0) _loadMatches(txn);
  }

  void _closePanel() => setState(() { _panelOpen = false; _selectedTxn = null; });

  Future<void> _loadMatches(Map<String,dynamic> txn) async {
    setState(() { _matchLoading = true; _matches = []; });
    try {
      final r = await _svc.getPossibleMatches(
        accountId: widget.accountId,
        amount:    (txn['amount'] ?? 0).toDouble(),
        txnType:   txn['transactionType'] ?? 'DEBIT',
        txnDate:   txn['transactionDate']?.toString() ?? '',
      );
      setState(() {
        _matches      = List<Map<String,dynamic>>.from(r['data'] ?? []);
        _matchLoading = false;
      });
    } catch (_) { setState(() => _matchLoading = false); }
  }

  // ── Save category directly from panel ────────────────────────────────────
  Future<void> _saveCategoryInPanel() async {
    final cat = _selectedCat;
    final txn = _selectedTxn;
    if (cat == null || txn == null) return;

    final txnId = txn['_id']?.toString() ?? '';
    final amount = (txn['amount'] ?? 0).toDouble();
    final date   = _parseDate(txn['transactionDate']);

    setState(() => _panelSaving = true);
    try {
      Map<String,dynamic> result;

      switch (cat.id) {
        // ── EXPENSE categories ────────────────────────────────────────────
        case 'expense':
        case 'card_payment':
        case 'owner_drawings':
        case 'credit_note_refund':
        case 'payment_refund':
          if (_selectedExpenseAccount == null) {
            _showError('Please select an expense account');
            setState(() => _panelSaving = false);
            return;
          }
          result = await _svc.categorizeAsExpense(
            providerTransactionId: txnId,
            coaAccountId:    _selectedExpenseAccount!,
            paidThroughId:   widget.accountId, // auto = current account
            amount:          amount,
            date:            DateFormat('yyyy-MM-dd').format(date),
            customerId:      _selectedCustomer?['_id']?.toString(),
            notes: _panelNotesCtrl.text.trim().isEmpty
                ? null : _panelNotesCtrl.text.trim(),
          );
          break;

        // ── VENDOR PAYMENT categories ──────────────────────────────────────
        case 'vendor_payment':
        case 'vendor_advance':
          result = await _svc.categorizeAsVendorPayment(
            providerTransactionId: txnId,
            vendorId:    _selectedVendor?['_id']?.toString(),
            amount:      amount,
            date:        DateFormat('yyyy-MM-dd').format(date),
            reference:   _panelRefCtrl.text.trim().isEmpty
                ? null : _panelRefCtrl.text.trim(),
            paidThroughId: widget.accountId,
            notes: _panelNotesCtrl.text.trim().isEmpty
                ? null : _panelNotesCtrl.text.trim(),
          );
          break;

        // ── CUSTOMER PAYMENT categories ────────────────────────────────────
        case 'customer_payment':
        case 'customer_advance':
          result = await _svc.categorizeAsCustomerPayment(
            providerTransactionId: txnId,
            customerId:   _selectedCustomer?['_id']?.toString(),
            amount:       amount,
            date:         DateFormat('yyyy-MM-dd').format(date),
            reference:    _panelRefCtrl.text.trim().isEmpty
                ? null : _panelRefCtrl.text.trim(),
            depositToId:  widget.accountId,
            notes: _panelNotesCtrl.text.trim().isEmpty
                ? null : _panelNotesCtrl.text.trim(),
          );
          break;

        // ── TRANSFER ──────────────────────────────────────────────────────
        case 'transfer_in':
        case 'transfer_out':
          if (_selectedToAccount == null) {
            _showError('Please select a destination account');
            setState(() => _panelSaving = false);
            return;
          }
          result = await _svc.categorizeAsTransfer(
            providerTransactionId: txnId,
            toAccountId:  _selectedToAccount!['_id']?.toString() ?? '',
            notes: _panelNotesCtrl.text.trim().isEmpty
                ? null : _panelNotesCtrl.text.trim(),
          );
          break;

        // ── SIMPLE DEPOSIT categories ─────────────────────────────────────
        default:
          final isIn = cat.group == 'money_in';
          if (isIn) {
            result = await _svc.categorizeAsDeposit(
              providerTransactionId: txnId,
              coaAccountId: _expCOAs.isNotEmpty ? _expCOAs.first.id : '',
              notes: _panelNotesCtrl.text.trim().isEmpty
                  ? null : _panelNotesCtrl.text.trim(),
            );
          } else {
            result = await _svc.categorizeAsExpense(
              providerTransactionId: txnId,
              coaAccountId:  _expCOAs.isNotEmpty ? _expCOAs.first.id : '',
              paidThroughId: widget.accountId,
              amount: amount,
              date:   DateFormat('yyyy-MM-dd').format(date),
              notes: _panelNotesCtrl.text.trim().isEmpty
                  ? null : _panelNotesCtrl.text.trim(),
            );
          }
          break;
      }

      if (result['success'] == true) {
        _showSuccess('Transaction categorized');
        _closePanel();
        _loadAll();
      } else {
        _showError(result['message'] ?? 'Categorization failed');
      }
    } catch (e) {
      _showError('Failed: $e');
    }
    setState(() => _panelSaving = false);
  }

  // ── Open Reconcile page (separate button) ─────────────────────────────────
  void _openReconcile() {
    Navigator.push(context, MaterialPageRoute(
      builder: (_) => ReconciliationBillingPage(
        accountId:   widget.accountId,
        accountName: widget.accountName,
        accountType: widget.accountType,
      ),
    )).then((_) { if (mounted) _loadAll(); });
  }

  // ==========================================================================
  //  BUILD
  // ==========================================================================

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      backgroundColor: const Color(0xFFF4F6F9),
      // ✅ FIX 1: Use Stack at Scaffold body level so panel can anchor to top
      body: Stack(
        children: [
          // Main content column
          Column(children: [
            _buildHeader(),
            _buildAmountStrip(),
            _buildTabsRow(),
            Expanded(child: TabBarView(
              controller: _tabCtrl,
              physics: const NeverScrollableScrollPhysics(),
              children: [
                _buildDashboard(),
                // ✅ FIX 1: Uncategorized tab content (list only, no stack here)
                _buildUncatContent(),
                // ✅ FIX 5: All Transactions tab — shows transaction list, NOT reconcile
                _buildAllTxnsTab(),
              ],
            )),
          ]),

          // ✅ FIX 1: Right panel overlaid at TOP of entire screen
          // Only visible when panelOpen AND on uncategorized tab
          if (_panelOpen && _tabCtrl.index == 1)
            _buildOverlayPanel(),
        ],
      ),
    );
  }

  // ── White header ──────────────────────────────────────────────────────────

  Widget _buildHeader() {
    final isWide = MediaQuery.of(context).size.width > 750;
    return Container(
      color: Colors.white,
      padding: const EdgeInsets.fromLTRB(16, 14, 12, 14),
      decoration: const BoxDecoration(
        border: Border(bottom: BorderSide(color: Color(0xFFE8ECF0))),
        boxShadow: [BoxShadow(color: Color(0x06000000), blurRadius: 4, offset: Offset(0,2))],
      ),
      child: Row(children: [
        InkWell(
          onTap: () => Navigator.pop(context),
          borderRadius: BorderRadius.circular(6),
          child: const Padding(padding: EdgeInsets.all(6),
              child: Icon(Icons.arrow_back, size: 18, color: Color(0xFF2C3E50))),
        ),
        const SizedBox(width: 10),
        Expanded(child: Column(crossAxisAlignment: CrossAxisAlignment.start, children: [
          Row(children: [
            Flexible(child: Text(widget.accountName,
                style: const TextStyle(fontSize: 16, fontWeight: FontWeight.bold,
                    color: Color(0xFF0F172A)), overflow: TextOverflow.ellipsis)),
            const SizedBox(width: 4),
            const Icon(Icons.keyboard_arrow_down, size: 16, color: Color(0xFF5D6D7E)),
          ]),
          if (widget.accountNumber != null)
            Text('Account Number: ${widget.accountNumber}',
                style: const TextStyle(fontSize: 11, color: Color(0xFF7F8C8D))),
        ])),
        const SizedBox(width: 8),
        if (isWide) ...[
          TextButton.icon(
            onPressed: () {},
            icon: const Icon(Icons.description_outlined, size: 14, color: _blue),
            label: const Text('Bank Statements',
                style: TextStyle(fontSize: 12, color: _blue, fontWeight: FontWeight.w500)),
            style: TextButton.styleFrom(
                padding: const EdgeInsets.symmetric(horizontal: 8, vertical: 6),
                minimumSize: Size.zero),
          ),
          const SizedBox(width: 4),
          _addTxnDropdown(),
          const SizedBox(width: 6),
          OutlinedButton(
            onPressed: _showRecordDeposit,
            style: OutlinedButton.styleFrom(
              foregroundColor: const Color(0xFF2C3E50),
              side: const BorderSide(color: Color(0xFFCBD5E1)),
              padding: const EdgeInsets.symmetric(horizontal: 12, vertical: 8),
              shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(6)),
              minimumSize: Size.zero,
            ),
            child: const Text('Record Deposit', style: TextStyle(fontSize: 12)),
          ),
          const SizedBox(width: 6),
          OutlinedButton(
            onPressed: _showImport,
            style: OutlinedButton.styleFrom(
              foregroundColor: const Color(0xFF2C3E50),
              side: const BorderSide(color: Color(0xFFCBD5E1)),
              padding: const EdgeInsets.symmetric(horizontal: 12, vertical: 8),
              shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(6)),
              minimumSize: Size.zero,
            ),
            child: const Text('Import Statement', style: TextStyle(fontSize: 12)),
          ),
          const SizedBox(width: 6),
          // ✅ FIX 5: Reconcile button in header
          OutlinedButton.icon(
            onPressed: _openReconcile,
            icon: const Icon(Icons.balance, size: 13),
            label: const Text('Reconcile', style: TextStyle(fontSize: 12)),
            style: OutlinedButton.styleFrom(
              foregroundColor: _teal,
              side: const BorderSide(color: _teal),
              padding: const EdgeInsets.symmetric(horizontal: 12, vertical: 8),
              shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(6)),
              minimumSize: Size.zero,
            ),
          ),
          const SizedBox(width: 6),
          _headerIcon(Icons.settings_outlined, () => _showRules()),
          const SizedBox(width: 4),
          _headerIcon(Icons.close, () => Navigator.pop(context), color: _red),
        ] else ...[
          _addTxnDropdown(),
          const SizedBox(width: 4),
          PopupMenuButton<String>(
            icon: const Icon(Icons.more_vert, size: 20, color: Color(0xFF5D6D7E)),
            onSelected: (v) {
              if (v == 'import')    _showImport();
              if (v == 'deposit')   _showRecordDeposit();
              if (v == 'rules')     _showRules();
              if (v == 'reconcile') _openReconcile();
            },
            itemBuilder: (_) => const [
              PopupMenuItem(value: 'import',    child: Text('Import Statement')),
              PopupMenuItem(value: 'deposit',   child: Text('Record Deposit')),
              PopupMenuItem(value: 'reconcile', child: Text('Reconcile')),
              PopupMenuItem(value: 'rules',     child: Text('Transaction Rules')),
            ],
          ),
        ],
      ]),
    );
  }

  Widget _addTxnDropdown() => PopupMenuButton<String>(
    onSelected: (type) => showDialog(context: context,
        builder: (_) => ManualEntryDialog(
          accountId: widget.accountId, accountName: widget.accountName,
          initialType: type,
          onSaved: () { _loadAll(); _showSuccess('Transaction added'); },
        )),
    itemBuilder: (_) => const [
      PopupMenuItem(value: 'expense',  child: Text('Expense')),
      PopupMenuItem(value: 'deposit',  child: Text('Deposit')),
      PopupMenuItem(value: 'transfer', child: Text('Transfer')),
    ],
    child: Container(
      padding: const EdgeInsets.symmetric(horizontal: 12, vertical: 8),
      decoration: BoxDecoration(
          color: _navyAccent, borderRadius: BorderRadius.circular(6)),
      child: Row(mainAxisSize: MainAxisSize.min, children: const [
        Text('Add Transaction', style: TextStyle(color: Colors.white, fontSize: 12,
            fontWeight: FontWeight.w600)),
        SizedBox(width: 4),
        Icon(Icons.arrow_drop_down, color: Colors.white, size: 16),
      ]),
    ),
  );

  Widget _headerIcon(IconData icon, VoidCallback onTap,
      {Color color = const Color(0xFF64748B)}) =>
      InkWell(
        onTap: onTap,
        borderRadius: BorderRadius.circular(6),
        child: Container(
          width: 32, height: 32,
          decoration: BoxDecoration(
            border: Border.all(color: color.withOpacity(0.3)),
            borderRadius: BorderRadius.circular(6),
          ),
          child: Icon(icon, size: 15, color: color),
        ),
      );

  // ── Amount strip ──────────────────────────────────────────────────────────

  Widget _buildAmountStrip() => Container(
    color: Colors.white,
    padding: const EdgeInsets.fromLTRB(20, 14, 20, 14),
    child: Row(children: [
      Container(
        padding: const EdgeInsets.all(10),
        decoration: BoxDecoration(
            color: _blue.withOpacity(0.08), borderRadius: BorderRadius.circular(8)),
        child: Icon(Icons.account_balance_outlined, color: _blue, size: 20),
      ),
      const SizedBox(width: 14),
      Column(crossAxisAlignment: CrossAxisAlignment.start, children: [
        const Text('Amount in Zoho Books',
            style: TextStyle(fontSize: 12, color: Color(0xFF7F8C8D))),
        Text(
          _statsLoading
              ? 'Loading...'
              : '₹${NumberFormat('#,##,##0.00').format(_balance)}',
          style: const TextStyle(fontSize: 20, fontWeight: FontWeight.bold,
              color: Color(0xFF0F172A)),
        ),
      ]),
    ]),
  );

  // ── Tabs row ──────────────────────────────────────────────────────────────

  Widget _buildTabsRow() => Container(
    color: Colors.white,
    child: Column(children: [
      Row(children: [
        Expanded(child: TabBar(
          controller: _tabCtrl,
          isScrollable: true,
          labelColor: _navyAccent,
          unselectedLabelColor: const Color(0xFF64748B),
          labelStyle: const TextStyle(fontSize: 13, fontWeight: FontWeight.w600),
          unselectedLabelStyle: const TextStyle(fontSize: 13),
          indicatorColor: _navyAccent,
          indicatorWeight: 2,
          tabAlignment: TabAlignment.start,
          tabs: [
            const Tab(text: 'Dashboard'),
            Tab(child: Row(mainAxisSize: MainAxisSize.min, children: [
              if (_uncatCount > 0) Container(
                margin: const EdgeInsets.only(right: 6),
                padding: const EdgeInsets.symmetric(horizontal: 7, vertical: 2),
                decoration: BoxDecoration(color: _navyAccent,
                    borderRadius: BorderRadius.circular(10)),
                child: Text('$_uncatCount', style: const TextStyle(
                    color: Colors.white, fontSize: 10, fontWeight: FontWeight.bold)),
              ),
              const Text('Uncategorized Transactions'),
              const SizedBox(width: 4),
              const Text('From Bank Statements',
                  style: TextStyle(fontSize: 10, color: Color(0xFF7F8C8D))),
            ])),
            // ✅ FIX 5: "All Transactions" — does NOT trigger reconcile
            const Tab(child: Row(mainAxisSize: MainAxisSize.min, children: [
              Text('All Transactions'),
              SizedBox(width: 4),
              Text('In Zoho Books', style: TextStyle(fontSize: 10, color: Color(0xFF7F8C8D))),
              SizedBox(width: 2),
              Icon(Icons.keyboard_arrow_down, size: 14),
            ])),
          ],
        )),
        Padding(
          padding: const EdgeInsets.only(right: 12),
          child: Row(children: [
            Text('Multi-Select & Match',
                style: TextStyle(fontSize: 11, color: Colors.grey[600],
                    fontStyle: FontStyle.italic)),
            const SizedBox(width: 6),
            Switch(
              value: _multiSelect, activeColor: _navyAccent,
              materialTapTargetSize: MaterialTapTargetSize.shrinkWrap,
              onChanged: (v) => setState(() { _multiSelect = v; if (!v) _selectedIds.clear(); }),
            ),
          ]),
        ),
      ]),
      const Divider(height: 1, color: Color(0xFFE8ECF0)),
    ]),
  );

  // ── Dashboard tab ─────────────────────────────────────────────────────────

  Widget _buildDashboard() => SingleChildScrollView(
    padding: const EdgeInsets.all(20),
    child: Column(crossAxisAlignment: CrossAxisAlignment.start, children: [
      const Text('Account Summary',
          style: TextStyle(fontSize: 14, fontWeight: FontWeight.bold, color: Color(0xFF2C3E50))),
      const SizedBox(height: 14),
      LayoutBuilder(builder: (_, c) {
        final cards = [
          _dashCard('Uncategorized', '$_uncatCount', _orange),
          _dashCard('Categorized',   '$_catCount',   _green),
          _dashCard('Total',         '$_total',      _blue),
        ];
        if (c.maxWidth > 480) {
          return Row(children: cards.asMap().entries.map((e) => Expanded(
            child: Padding(padding: EdgeInsets.only(right: e.key < 2 ? 10 : 0),
                child: e.value))).toList());
        }
        return Column(children: cards.map((c) =>
            Padding(padding: const EdgeInsets.only(bottom: 10), child: c)).toList());
      }),
      if (_uncatCount > 0) ...[
        const SizedBox(height: 16),
        Container(
          padding: const EdgeInsets.all(14),
          decoration: BoxDecoration(
            color: _orange.withOpacity(0.06),
            borderRadius: BorderRadius.circular(8),
            border: Border.all(color: _orange.withOpacity(0.2)),
          ),
          child: Row(children: [
            Icon(Icons.warning_amber_rounded, color: _orange, size: 18),
            const SizedBox(width: 10),
            Expanded(child: Text('$_uncatCount transactions need categorization',
                style: const TextStyle(fontSize: 13, fontWeight: FontWeight.w500))),
            TextButton(
              onPressed: () => _tabCtrl.animateTo(1),
              style: TextButton.styleFrom(foregroundColor: _orange,
                  padding: EdgeInsets.zero, minimumSize: Size.zero),
              child: const Text('Categorize now ›', style: TextStyle(fontSize: 12)),
            ),
          ]),
        ),
      ],
    ]),
  );

  Widget _dashCard(String label, String value, Color color) => Container(
    padding: const EdgeInsets.all(14),
    decoration: BoxDecoration(
      color: Colors.white,
      borderRadius: BorderRadius.circular(8),
      border: Border.all(color: color.withOpacity(0.15)),
      boxShadow: [BoxShadow(color: color.withOpacity(0.05), blurRadius: 6, offset: const Offset(0,2))],
    ),
    child: Row(children: [
      Container(width: 4, height: 36,
          decoration: BoxDecoration(color: color, borderRadius: BorderRadius.circular(2))),
      const SizedBox(width: 12),
      Column(crossAxisAlignment: CrossAxisAlignment.start, children: [
        Text(value, style: TextStyle(fontSize: 20, fontWeight: FontWeight.bold, color: color)),
        Text(label, style: const TextStyle(fontSize: 11, color: Color(0xFF7F8C8D))),
      ]),
    ]),
  );

  // ── Uncategorized tab content (no Stack — panel is handled by Scaffold overlay) ──

  Widget _buildUncatContent() => Column(children: [
    _buildFilterRow(),
    Expanded(child: _txnsLoading
        ? const Center(child: CircularProgressIndicator(color: _navyAccent))
        : _filtered.isEmpty
            ? _buildEmptyState()
            : _buildTable()),
  ]);

  // ── Filter chips ──────────────────────────────────────────────────────────

  Widget _buildFilterRow() => Container(
    color: Colors.white,
    padding: const EdgeInsets.symmetric(horizontal: 16, vertical: 10),
    decoration: const BoxDecoration(
        border: Border(bottom: BorderSide(color: Color(0xFFEEF2F7)))),
    child: Row(children: [
      _chip('All',        '${_txns.length}'),
      const SizedBox(width: 8),
      _chip('Recognized', '${_txns.where((t) => t['isRecognized'] == true).length}'),
      const Spacer(),
      GestureDetector(
        onTap: () => setState(() => _filter = 'Excluded'),
        child: Text('Excluded',
            style: TextStyle(fontSize: 13,
                color: _filter == 'Excluded' ? _navyAccent : const Color(0xFF5D6D7E),
                fontWeight: _filter == 'Excluded' ? FontWeight.w600 : FontWeight.normal)),
      ),
    ]),
  );

  Widget _chip(String label, String count) {
    final sel = _filter == label;
    return InkWell(
      onTap: () => setState(() => _filter = label),
      borderRadius: BorderRadius.circular(20),
      child: Container(
        padding: const EdgeInsets.symmetric(horizontal: 14, vertical: 5),
        decoration: BoxDecoration(
          color: sel ? _navyAccent : Colors.transparent,
          borderRadius: BorderRadius.circular(20),
          border: Border.all(color: sel ? _navyAccent : const Color(0xFFCBD5E1)),
        ),
        child: Text('$label ($count)',
            style: TextStyle(fontSize: 12, fontWeight: FontWeight.w600,
                color: sel ? Colors.white : const Color(0xFF5D6D7E))),
      ),
    );
  }

  // ── Transaction table ─────────────────────────────────────────────────────

  Widget _buildTable() => Column(children: [
    Container(
      color: const Color(0xFFF8F9FB),
      padding: const EdgeInsets.symmetric(horizontal: 16, vertical: 10),
      child: Row(children: [
        SizedBox(width: 36, child: Checkbox(
          value: _selectedIds.length == _filtered.length && _filtered.isNotEmpty,
          tristate: true,
          onChanged: (v) => setState(() {
            if (v == true) _selectedIds = _filtered.map((t) => t['_id'].toString()).toSet();
            else           _selectedIds.clear();
          }),
          activeColor: _navyAccent,
          materialTapTargetSize: MaterialTapTargetSize.shrinkWrap,
        )),
        _col('DATE ↕', 100),
        const Expanded(child: Text('STATEMENT DETAILS',
            style: TextStyle(fontSize: 10, fontWeight: FontWeight.bold,
                color: Color(0xFF7F8C8D), letterSpacing: 0.4))),
        _col('DEPOSITS', 110, align: TextAlign.right),
        _col('WITHDRAWALS', 110, align: TextAlign.right),
        const SizedBox(width: 36, child: Icon(Icons.search, size: 14, color: Color(0xFF7F8C8D))),
      ]),
    ),
    const Divider(height: 1, color: Color(0xFFEEF2F7)),
    Expanded(child: RefreshIndicator(
      color: _navyAccent,
      onRefresh: _loadAll,
      child: ListView.separated(
        physics: const AlwaysScrollableScrollPhysics(),
        itemCount: _filtered.length,
        separatorBuilder: (_, __) => const Divider(height: 1, color: Color(0xFFEEF2F7)),
        itemBuilder: (_, i) => _buildRow(_filtered[i]),
      ),
    )),
  ]);

  Widget _col(String label, double width, {TextAlign align = TextAlign.left}) =>
      SizedBox(width: width, child: Text(label,
          style: const TextStyle(fontSize: 10, fontWeight: FontWeight.bold,
              color: Color(0xFF7F8C8D), letterSpacing: 0.4),
          textAlign: align));

  Widget _buildRow(Map<String,dynamic> txn) {
    final id       = txn['_id']?.toString() ?? '';
    final isDebit  = txn['transactionType'] == 'DEBIT';
    final amount   = (txn['amount'] ?? 0).toDouble();
    final date     = _parseDate(txn['transactionDate']);
    final refNum   = txn['referenceNumber']?.toString() ?? '';
    final desc     = txn['description']?.toString() ?? '';
    final payee    = txn['payee']?.toString() ??
                     txn['vendorName']?.toString() ??
                     txn['customerName']?.toString() ?? '';
    final isSelected = _selectedTxn?['_id']?.toString() == id;
    final isChecked  = _selectedIds.contains(id);

    return InkWell(
      onTap: () => _openPanel(txn, tab: 0),
      child: Container(
        color: isSelected ? _navyAccent.withOpacity(0.05) : Colors.white,
        padding: const EdgeInsets.symmetric(horizontal: 16, vertical: 14),
        child: Row(crossAxisAlignment: CrossAxisAlignment.start, children: [
          SizedBox(width: 36, child: Checkbox(
            value: isChecked,
            onChanged: (_) => setState(() {
              if (isChecked) _selectedIds.remove(id); else _selectedIds.add(id);
            }),
            activeColor: _navyAccent,
            materialTapTargetSize: MaterialTapTargetSize.shrinkWrap,
          )),
          SizedBox(width: 100, child: Text(
            DateFormat('dd/MM/yyyy').format(date),
            style: const TextStyle(fontSize: 13, color: Color(0xFF2C3E50),
                fontWeight: FontWeight.w500),
          )),
          Expanded(child: Column(crossAxisAlignment: CrossAxisAlignment.start, children: [
            if (refNum.isNotEmpty)
              Text('Reference#: $refNum',
                  style: const TextStyle(fontSize: 12, color: Color(0xFF2C3E50))),
            if (desc.isNotEmpty)
              Text('Description: $desc',
                  style: const TextStyle(fontSize: 12, color: Color(0xFF5D6D7E))),
            if (payee.isNotEmpty)
              Text('Payee: $payee',
                  style: const TextStyle(fontSize: 12, color: Color(0xFF5D6D7E))),
          ])),
          SizedBox(width: 110, child: Text(
            !isDebit ? '₹${NumberFormat('#,##,##0.00').format(amount)}' : '',
            style: const TextStyle(fontSize: 13, color: Color(0xFF2C3E50),
                fontWeight: FontWeight.w500),
            textAlign: TextAlign.right,
          )),
          SizedBox(width: 110, child: Text(
            isDebit ? '₹${NumberFormat('#,##,##0.00').format(amount)}' : '',
            style: const TextStyle(fontSize: 13, color: Color(0xFF2C3E50),
                fontWeight: FontWeight.w500),
            textAlign: TextAlign.right,
          )),
          const SizedBox(width: 36),
        ]),
      ),
    );
  }

  Widget _buildEmptyState() => Center(child: Column(mainAxisAlignment: MainAxisAlignment.center, children: [
    Icon(Icons.check_circle_outline, size: 52, color: Colors.grey[300]),
    const SizedBox(height: 14),
    const Text('No uncategorized transactions',
        style: TextStyle(fontSize: 14, color: Color(0xFF7F8C8D))),
    const SizedBox(height: 16),
    OutlinedButton.icon(
      onPressed: _showImport,
      icon: const Icon(Icons.upload_file_outlined, size: 16),
      label: const Text('Import Statement'),
      style: OutlinedButton.styleFrom(foregroundColor: _navyAccent,
          side: const BorderSide(color: _navyAccent)),
    ),
  ]));

  // ── All Transactions tab ──────────────────────────────────────────────────
  // ✅ FIX 5: This is just a list — no reconcile trigger

  Widget _buildAllTxnsTab() {
    if (_txnsLoading) {
      return const Center(child: CircularProgressIndicator(color: _navyAccent));
    }
    if (_allTxns.isEmpty) {
      return Center(child: Column(mainAxisAlignment: MainAxisAlignment.center, children: [
        Icon(Icons.receipt_long_outlined, size: 52, color: Colors.grey[300]),
        const SizedBox(height: 14),
        const Text('No transactions yet',
            style: TextStyle(fontSize: 14, color: Color(0xFF7F8C8D))),
      ]));
    }

    return ListView.separated(
      itemCount: _allTxns.length,
      separatorBuilder: (_, __) => const Divider(height: 1, color: Color(0xFFEEF2F7)),
      itemBuilder: (_, i) {
        final txn    = _allTxns[i];
        final isDebit= txn['transactionType'] == 'DEBIT';
        final amount = (txn['amount'] ?? 0).toDouble();
        final date   = _parseDate(txn['transactionDate'] ?? txn['date']);
        final status = txn['reconciliationStatus']?.toString() ?? 'UNCATEGORIZED';
        final desc   = txn['description']?.toString() ?? '';
        Color sc;
        switch (status) {
          case 'CATEGORIZED': sc = _green;  break;
          case 'EXCLUDED':    sc = Colors.grey; break;
          default:            sc = _orange;
        }
        return Container(
          color: Colors.white,
          padding: const EdgeInsets.symmetric(horizontal: 20, vertical: 12),
          child: Row(children: [
            SizedBox(width: 90, child: Text(DateFormat('dd/MM/yyyy').format(date),
                style: const TextStyle(fontSize: 12, color: Color(0xFF5D6D7E)))),
            const SizedBox(width: 12),
            Expanded(child: Text(desc.isNotEmpty ? desc : (isDebit ? 'Debit' : 'Credit'),
                style: const TextStyle(fontSize: 13, color: Color(0xFF2C3E50)),
                maxLines: 1, overflow: TextOverflow.ellipsis)),
            const SizedBox(width: 10),
            Container(
              padding: const EdgeInsets.symmetric(horizontal: 7, vertical: 3),
              decoration: BoxDecoration(color: sc.withOpacity(0.1),
                  borderRadius: BorderRadius.circular(4)),
              child: Text(status, style: TextStyle(fontSize: 9,
                  fontWeight: FontWeight.bold, color: sc)),
            ),
            const SizedBox(width: 10),
            Text('${isDebit ? '-' : '+'}₹${NumberFormat('#,##,##0.00').format(amount)}',
                style: TextStyle(fontSize: 13, fontWeight: FontWeight.bold,
                    color: isDebit ? _red : _green)),
          ]),
        );
      },
    );
  }

  // ==========================================================================
  //  ✅ FIX 1: OVERLAY PANEL — anchored to TOP via Positioned
  //  Uses LayoutBuilder on the Stack's constraints to position correctly
  // ==========================================================================

  Widget _buildOverlayPanel() {
    return LayoutBuilder(builder: (context, constraints) {
      final isDesktop = constraints.maxWidth > 900;
      final panelW    = isDesktop ? constraints.maxWidth * 0.42 : constraints.maxWidth;

      return Stack(
        children: [
          Positioned(
            top:    0,
            right:  0,
            bottom: 0,
            width:  panelW,
            child: _buildRightPanel(),
          ),
        ],
      );
    });
  }

  // ==========================================================================
  //  RIGHT PANEL
  // ==========================================================================

  Widget _buildRightPanel() => Container(
    decoration: const BoxDecoration(
      color: Colors.white,
      boxShadow: [BoxShadow(color: Color(0x20000000), blurRadius: 20, offset: Offset(-4,0))],
    ),
    child: Column(children: [
      _buildPanelHeader(),
      _buildPanelTabs(),
      Expanded(child: _panelTab == 0 ? _buildMatchPanel() : _buildCatPanel()),
    ]),
  );

  Widget _buildPanelHeader() {
    final txn     = _selectedTxn;
    if (txn == null) return const SizedBox.shrink();
    final isDebit = txn['transactionType'] == 'DEBIT';
    final amount  = (txn['amount'] ?? 0).toDouble();
    final date    = _parseDate(txn['transactionDate']);
    final desc    = txn['description']?.toString() ?? '';

    return Container(
      padding: const EdgeInsets.fromLTRB(16, 14, 12, 14),
      decoration: const BoxDecoration(
          border: Border(bottom: BorderSide(color: Color(0xFFEEF2F7)))),
      child: Row(children: [
        Container(
          padding: const EdgeInsets.symmetric(horizontal: 12, vertical: 6),
          decoration: BoxDecoration(
            color: (isDebit ? _red : _green).withOpacity(0.1),
            borderRadius: BorderRadius.circular(6),
          ),
          child: Text(
            '${isDebit ? '-' : '+'}₹${NumberFormat('#,##,##0.00').format(amount)}',
            style: TextStyle(fontSize: 14, fontWeight: FontWeight.bold,
                color: isDebit ? _red : _green),
          ),
        ),
        const SizedBox(width: 10),
        Expanded(child: Column(crossAxisAlignment: CrossAxisAlignment.start, children: [
          Text(desc.isNotEmpty ? desc : (isDebit ? 'Debit' : 'Credit'),
              style: const TextStyle(fontSize: 12, fontWeight: FontWeight.w500,
                  color: Color(0xFF2C3E50)),
              maxLines: 1, overflow: TextOverflow.ellipsis),
          Text(DateFormat('dd MMM yyyy').format(date),
              style: const TextStyle(fontSize: 11, color: Color(0xFF7F8C8D))),
        ])),
        InkWell(onTap: _closePanel,
            child: const Icon(Icons.close, size: 16, color: Color(0xFF7F8C8D))),
      ]),
    );
  }

  Widget _buildPanelTabs() => Row(children: [
    Expanded(child: _panelTabBtn('MATCH TRANSACTIONS', 0)),
    Expanded(child: _panelTabBtn('CATEGORIZE MANUALLY', 1)),
  ]);

  Widget _panelTabBtn(String label, int idx) => InkWell(
    onTap: () {
      setState(() => _panelTab = idx);
      if (idx == 0 && _selectedTxn != null) _loadMatches(_selectedTxn!);
    },
    child: Container(
      padding: const EdgeInsets.symmetric(vertical: 12),
      decoration: BoxDecoration(
        border: Border(bottom: BorderSide(
            color: _panelTab == idx ? _navyAccent : const Color(0xFFEEF2F7),
            width: _panelTab == idx ? 2 : 1)),
      ),
      child: Text(label, textAlign: TextAlign.center,
          style: TextStyle(fontSize: 11, fontWeight: FontWeight.bold,
              color: _panelTab == idx ? _navyAccent : const Color(0xFF7F8C8D),
              letterSpacing: 0.2)),
    ),
  );

  // ── Match panel ───────────────────────────────────────────────────────────

  Widget _buildMatchPanel() => Column(children: [
    Expanded(child: _matchLoading
        ? const Center(child: CircularProgressIndicator(color: _navyAccent, strokeWidth: 2))
        : _matches.isEmpty ? _buildNoMatches() : _buildMatchList()),
    if (_matches.isNotEmpty) _buildMatchFooter(),
  ]);

  Widget _buildNoMatches() => Padding(
    padding: const EdgeInsets.all(24),
    child: Column(children: [
      const SizedBox(height: 16),
      const Align(alignment: Alignment.centerLeft, child: Text('Possible Matches',
          style: TextStyle(fontSize: 13, fontWeight: FontWeight.bold, color: Color(0xFF2C3E50)))),
      Align(alignment: Alignment.centerLeft, child: Text(
        'Transactions upto ${DateFormat('dd/MM/yyyy').format(DateTime.now())}',
        style: const TextStyle(fontSize: 11, color: Color(0xFF7F8C8D)))),
      const SizedBox(height: 48),
      Icon(Icons.search_off, size: 40, color: Colors.grey[300]),
      const SizedBox(height: 12),
      const Text('There are no transactions matching the selected criteria.',
          style: TextStyle(fontSize: 12, color: Color(0xFF7F8C8D)),
          textAlign: TextAlign.center),
      const SizedBox(height: 20),
      SizedBox(width: double.infinity, child: OutlinedButton(
        onPressed: () => setState(() => _panelTab = 1),
        style: OutlinedButton.styleFrom(foregroundColor: _navyAccent,
            side: const BorderSide(color: _navyAccent),
            shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(6))),
        child: const Text('Categorize Manually'),
      )),
    ]),
  );

  Widget _buildMatchList() => SingleChildScrollView(
    padding: const EdgeInsets.all(16),
    child: Column(crossAxisAlignment: CrossAxisAlignment.start, children: [
      Row(children: [
        const Text('Possible Matches',
            style: TextStyle(fontSize: 13, fontWeight: FontWeight.bold)),
        const Spacer(),
        TextButton(onPressed: () => setState(() {
          for (final m in _matches) m['_selected'] = true;
        }), style: TextButton.styleFrom(foregroundColor: _navyAccent,
            visualDensity: VisualDensity.compact, padding: EdgeInsets.zero),
            child: const Text('SELECT ALL', style: TextStyle(fontSize: 11))),
        const SizedBox(width: 6),
        Icon(Icons.filter_list, size: 16, color: Colors.grey[400]),
      ]),
      Text('Transactions upto ${DateFormat('dd/MM/yyyy').format(DateTime.now())}',
          style: const TextStyle(fontSize: 11, color: Color(0xFF7F8C8D))),
      const SizedBox(height: 12),
      ..._matches.map((m) => _buildMatchCard(m)),
    ]),
  );

  Widget _buildMatchCard(Map<String,dynamic> m) {
    final type   = m['type']?.toString() ?? 'Record';
    final amount = (m['amount'] ?? m['total'] ?? 0).toDouble();
    final refNum = m['invoiceNumber'] ?? m['billNumber'] ?? m['referenceNumber'] ?? '';
    final name   = m['customerName'] ?? m['vendorName'] ?? '';
    final sel    = m['_selected'] == true;
    Color tc;
    switch (type.toLowerCase()) {
      case 'invoice':     tc = _green;  break;
      case 'bill':        tc = _orange; break;
      case 'credit note': tc = _purple; break;
      default:            tc = _blue;
    }
    return InkWell(
      onTap: () => setState(() => m['_selected'] = !(m['_selected'] ?? false)),
      borderRadius: BorderRadius.circular(8),
      child: Container(
        margin: const EdgeInsets.only(bottom: 10),
        padding: const EdgeInsets.all(12),
        decoration: BoxDecoration(
          color: sel ? tc.withOpacity(0.06) : Colors.white,
          borderRadius: BorderRadius.circular(8),
          border: Border.all(color: sel ? tc : const Color(0xFFE2E8F0),
              width: sel ? 1.5 : 1),
        ),
        child: Row(children: [
          Expanded(child: Column(crossAxisAlignment: CrossAxisAlignment.start, children: [
            Row(children: [
              Container(
                padding: const EdgeInsets.symmetric(horizontal: 6, vertical: 3),
                decoration: BoxDecoration(color: tc.withOpacity(0.1),
                    borderRadius: BorderRadius.circular(4)),
                child: Text(type, style: TextStyle(fontSize: 9,
                    fontWeight: FontWeight.bold, color: tc)),
              ),
              const SizedBox(width: 8),
              Text('for ₹${NumberFormat('#,##,##0.00').format(amount)}',
                  style: const TextStyle(fontSize: 13, fontWeight: FontWeight.bold,
                      color: Color(0xFF2C3E50))),
            ]),
            if (name.isNotEmpty || refNum.isNotEmpty) ...[
              const SizedBox(height: 4),
              Text([if (name.isNotEmpty) name, if (refNum.toString().isNotEmpty) refNum.toString()].join(' | '),
                  style: const TextStyle(fontSize: 11, color: Color(0xFF7F8C8D))),
            ],
          ])),
          const SizedBox(width: 8),
          sel
              ? Container(
                  padding: const EdgeInsets.symmetric(horizontal: 8, vertical: 4),
                  decoration: BoxDecoration(color: tc, borderRadius: BorderRadius.circular(5)),
                  child: Row(mainAxisSize: MainAxisSize.min, children: const [
                    Icon(Icons.check, color: Colors.white, size: 12),
                    SizedBox(width: 4),
                    Text('Selected', style: TextStyle(color: Colors.white, fontSize: 10,
                        fontWeight: FontWeight.bold)),
                  ]))
              : OutlinedButton(
                  onPressed: () => setState(() => m['_selected'] = true),
                  style: OutlinedButton.styleFrom(
                      foregroundColor: tc, side: BorderSide(color: tc),
                      padding: const EdgeInsets.symmetric(horizontal: 10, vertical: 4),
                      minimumSize: Size.zero,
                      shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(5))),
                  child: const Text('Select', style: TextStyle(fontSize: 11))),
        ]),
      ),
    );
  }

  Widget _buildMatchFooter() => Container(
    padding: const EdgeInsets.all(16),
    decoration: const BoxDecoration(
        border: Border(top: BorderSide(color: Color(0xFFEEF2F7)))),
    child: Row(children: [
      Expanded(child: OutlinedButton(
        onPressed: _closePanel,
        style: OutlinedButton.styleFrom(
            side: const BorderSide(color: Color(0xFFCBD5E1)),
            padding: const EdgeInsets.symmetric(vertical: 11),
            shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(6))),
        child: const Text('Cancel', style: TextStyle(color: Color(0xFF5D6D7E))),
      )),
      const SizedBox(width: 10),
      Expanded(child: ElevatedButton(
        onPressed: _doMatch,
        style: ElevatedButton.styleFrom(
            backgroundColor: _navyAccent, foregroundColor: Colors.white,
            padding: const EdgeInsets.symmetric(vertical: 11),
            shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(6))),
        child: const Text('Match', style: TextStyle(fontWeight: FontWeight.bold)),
      )),
    ]),
  );

  Future<void> _doMatch() async {
    final selected = _matches.where((m) => m['_selected'] == true).toList();
    if (selected.isEmpty) { _showError('Select at least one match'); return; }
    final txnId = _selectedTxn?['_id']?.toString() ?? '';
    try {
      final m    = selected.first;
      final type = m['type']?.toString().toLowerCase() ?? '';
      Map<String,dynamic> r;
      if (type == 'invoice') {
        r = await _svc.matchToInvoice(providerTransactionId: txnId,
            invoiceId: m['_id'].toString());
      } else if (type == 'bill') {
        r = await _svc.matchToBill(providerTransactionId: txnId,
            billId: m['_id'].toString());
      } else {
        r = await _svc.matchToRecord(providerTransactionId: txnId,
            recordId: m['_id'].toString(), recordType: type);
      }
      if (r['success'] == true) {
        _showSuccess('Transaction matched');
        _closePanel(); _loadAll();
      } else { _showError(r['message'] ?? 'Match failed'); }
    } catch (e) { _showError('Failed: $e'); }
  }

  // ── Categorize panel ──────────────────────────────────────────────────────

  Widget _buildCatPanel() {
    final txn     = _selectedTxn;
    if (txn == null) return const SizedBox.shrink();
    final isDebit = txn['transactionType'] == 'DEBIT';
    final cats    = isDebit ? _moneyOut : _moneyIn;
    final groupLbl= isDebit ? 'Money Out' : 'Money In';

    return Column(children: [
      Expanded(child: SingleChildScrollView(
        padding: const EdgeInsets.fromLTRB(16, 16, 16, 0),
        child: Column(crossAxisAlignment: CrossAxisAlignment.start, children: [
          RichText(text: const TextSpan(
            text: 'Category',
            style: TextStyle(fontSize: 12, fontWeight: FontWeight.w600, color: Color(0xFF374151)),
            children: [TextSpan(text: ' *', style: TextStyle(color: Colors.red))],
          )),
          const SizedBox(height: 8),
          _buildCatDropdown(cats, groupLbl),
          if (_selectedCat != null) ...[
            const SizedBox(height: 16),
            // ✅ FIX 2: Forms embedded directly in the panel
            _buildInlineCatForm(txn),
          ],
        ]),
      )),
      if (_selectedCat != null)
        Container(
          padding: const EdgeInsets.all(16),
          decoration: const BoxDecoration(
              border: Border(top: BorderSide(color: Color(0xFFEEF2F7)))),
          child: Row(children: [
            Expanded(child: OutlinedButton(
              onPressed: _panelSaving ? null : _closePanel,
              style: OutlinedButton.styleFrom(
                  side: const BorderSide(color: Color(0xFFCBD5E1)),
                  padding: const EdgeInsets.symmetric(vertical: 11),
                  shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(6))),
              child: const Text('Cancel', style: TextStyle(color: Color(0xFF5D6D7E))),
            )),
            const SizedBox(width: 10),
            Expanded(child: ElevatedButton(
              onPressed: _panelSaving ? null : _saveCategoryInPanel,
              style: ElevatedButton.styleFrom(
                  backgroundColor: _navyAccent, foregroundColor: Colors.white,
                  padding: const EdgeInsets.symmetric(vertical: 11),
                  shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(6))),
              child: _panelSaving
                  ? const SizedBox(width: 18, height: 18,
                      child: CircularProgressIndicator(strokeWidth: 2, color: Colors.white))
                  : const Text('Save', style: TextStyle(fontWeight: FontWeight.bold)),
            )),
          ]),
        ),
    ]);
  }

  // ✅ FIX 2 & 3: Per-category inline forms — everything inside the 40% panel
  Widget _buildInlineCatForm(Map<String,dynamic> txn) {
    final cat    = _selectedCat!;
    final amount = (txn['amount'] ?? 0).toDouble();
    final date   = _parseDate(txn['transactionDate']);

    // Pre-filled amount chip
    Widget amtChip = Container(
      padding: const EdgeInsets.symmetric(horizontal: 12, vertical: 10),
      decoration: BoxDecoration(
        color: const Color(0xFFF8F9FA),
        border: Border.all(color: const Color(0xFFCBD5E1)),
        borderRadius: BorderRadius.circular(6),
      ),
      child: Row(children: [
        const Text('₹ ', style: TextStyle(fontSize: 13, color: Color(0xFF7F8C8D))),
        Text(NumberFormat('#,##,##0.00').format(amount),
            style: const TextStyle(fontSize: 15, fontWeight: FontWeight.bold,
                color: Color(0xFF2C3E50))),
        const Spacer(),
        const Text('pre-filled', style: TextStyle(fontSize: 10, color: Color(0xFF7F8C8D))),
      ]),
    );

    // Pre-filled date chip
    Widget dateChip = Container(
      padding: const EdgeInsets.symmetric(horizontal: 12, vertical: 10),
      decoration: BoxDecoration(
        color: const Color(0xFFF8F9FA),
        border: Border.all(color: const Color(0xFFCBD5E1)),
        borderRadius: BorderRadius.circular(6),
      ),
      child: Row(children: [
        const Icon(Icons.calendar_today_outlined, size: 14, color: Color(0xFF7F8C8D)),
        const SizedBox(width: 8),
        Text(DateFormat('dd MMM yyyy').format(date),
            style: const TextStyle(fontSize: 13, color: Color(0xFF2C3E50))),
        const Spacer(),
        const Text('pre-filled', style: TextStyle(fontSize: 10, color: Color(0xFF7F8C8D))),
      ]),
    );

    // Current account chip (Paid Through — auto)
    Widget paidChip = Container(
      padding: const EdgeInsets.symmetric(horizontal: 12, vertical: 10),
      decoration: BoxDecoration(
        color: _navyAccent.withOpacity(0.05),
        border: Border.all(color: _navyAccent.withOpacity(0.3)),
        borderRadius: BorderRadius.circular(6),
      ),
      child: Row(children: [
        Icon(Icons.account_balance_outlined, size: 14, color: _navyAccent),
        const SizedBox(width: 8),
        Expanded(child: Text(widget.accountName,
            style: TextStyle(fontSize: 13, color: _navyAccent,
                fontWeight: FontWeight.w500),
            overflow: TextOverflow.ellipsis)),
        const Text('auto', style: TextStyle(fontSize: 10, color: Color(0xFF7F8C8D))),
      ]),
    );

    switch (cat.id) {

      // ── EXPENSE / CARD PAYMENT / OWNER DRAWINGS ─────────────────────────
      case 'expense':
      case 'card_payment':
      case 'owner_drawings':
      case 'credit_note_refund':
      case 'payment_refund':
        return Column(crossAxisAlignment: CrossAxisAlignment.start, children: [
          _fLabel('Expense Account *'),
          const SizedBox(height: 6),
          _expCOAs.isEmpty
              ? Container(
                  padding: const EdgeInsets.all(12),
                  decoration: BoxDecoration(
                    border: Border.all(color: const Color(0xFFCBD5E1)),
                    borderRadius: BorderRadius.circular(6),
                  ),
                  child: const Text('No expense accounts found',
                      style: TextStyle(fontSize: 12, color: Color(0xFF7F8C8D))),
                )
              : DropdownButtonFormField<String>(
                  value: _selectedExpenseAccount,
                  decoration: InputDecoration(
                    prefixIcon: const Icon(Icons.account_tree_outlined, size: 16),
                    border: OutlineInputBorder(borderRadius: BorderRadius.circular(6)),
                    isDense: true,
                    contentPadding: const EdgeInsets.symmetric(horizontal: 10, vertical: 12),
                    hintText: 'Select account',
                    hintStyle: const TextStyle(fontSize: 13),
                  ),
                  isExpanded: true,
                  items: _expCOAs.map((c) => DropdownMenuItem(
                    value: c.id,
                    child: Text(c.name, overflow: TextOverflow.ellipsis,
                        style: const TextStyle(fontSize: 13)),
                  )).toList(),
                  onChanged: (v) => setState(() => _selectedExpenseAccount = v),
                ),
          const SizedBox(height: 12),
          _fLabel('Date'),
          const SizedBox(height: 6),
          dateChip,
          const SizedBox(height: 12),
          _fLabel('Amount'),
          const SizedBox(height: 6),
          amtChip,
          const SizedBox(height: 12),
          _fLabel('Paid Through (auto)'),
          const SizedBox(height: 6),
          paidChip,
          const SizedBox(height: 12),
          // ✅ Customer optional
          _fLabel('Customer (optional)'),
          const SizedBox(height: 6),
          _buildCustomerSearch(),
          const SizedBox(height: 12),
          _fLabel('Notes (optional)'),
          const SizedBox(height: 6),
          _fField(_panelNotesCtrl, 'Notes', Icons.note_outlined, maxLines: 2),
        ]);

      // ── VENDOR PAYMENT / VENDOR ADVANCE ─────────────────────────────────
      case 'vendor_payment':
      case 'vendor_advance':
        return Column(crossAxisAlignment: CrossAxisAlignment.start, children: [
          _fLabel('Vendor'),
          const SizedBox(height: 6),
          _buildVendorSearch(),
          const SizedBox(height: 12),
          _fLabel('Amount'),
          const SizedBox(height: 6),
          amtChip,
          const SizedBox(height: 12),
          _fLabel('Date'),
          const SizedBox(height: 6),
          dateChip,
          const SizedBox(height: 12),
          _fLabel('Reference'),
          const SizedBox(height: 6),
          _fField(_panelRefCtrl, 'Reference Number', Icons.tag),
          const SizedBox(height: 12),
          _fLabel('Paid Through (auto)'),
          const SizedBox(height: 6),
          paidChip,
          const SizedBox(height: 12),
          _fLabel('Notes (optional)'),
          const SizedBox(height: 6),
          _fField(_panelNotesCtrl, 'Notes', Icons.note_outlined, maxLines: 2),
        ]);

      // ── CUSTOMER PAYMENT / CUSTOMER ADVANCE ─────────────────────────────
      case 'customer_payment':
      case 'customer_advance':
        return Column(crossAxisAlignment: CrossAxisAlignment.start, children: [
          _fLabel('Customer'),
          const SizedBox(height: 6),
          _buildCustomerSearch(),
          const SizedBox(height: 12),
          _fLabel('Amount'),
          const SizedBox(height: 6),
          amtChip,
          const SizedBox(height: 12),
          _fLabel('Date'),
          const SizedBox(height: 6),
          dateChip,
          const SizedBox(height: 12),
          _fLabel('Reference'),
          const SizedBox(height: 6),
          _fField(_panelRefCtrl, 'Reference Number', Icons.tag),
          const SizedBox(height: 12),
          _fLabel('Deposit To (auto)'),
          const SizedBox(height: 6),
          paidChip,
          const SizedBox(height: 12),
          _fLabel('Notes (optional)'),
          const SizedBox(height: 6),
          _fField(_panelNotesCtrl, 'Notes', Icons.note_outlined, maxLines: 2),
        ]);

      // ── TRANSFER ─────────────────────────────────────────────────────────
      case 'transfer_in':
      case 'transfer_out':
        return Column(crossAxisAlignment: CrossAxisAlignment.start, children: [
          _fLabel(cat.id == 'transfer_out'
              ? 'Transfer To Account *' : 'Transfer From Account *'),
          const SizedBox(height: 6),
          DropdownButtonFormField<Map<String,dynamic>>(
            value: _selectedToAccount,
            decoration: InputDecoration(
              prefixIcon: const Icon(Icons.account_balance, size: 16),
              border: OutlineInputBorder(borderRadius: BorderRadius.circular(6)),
              isDense: true,
              contentPadding: const EdgeInsets.symmetric(horizontal: 10, vertical: 12),
            ),
            isExpanded: true,
            hint: const Text('Select account', style: TextStyle(fontSize: 13)),
            items: _bankAccounts.map((a) => DropdownMenuItem(
              value: a,
              child: Text(a['accountName']?.toString() ?? '',
                  overflow: TextOverflow.ellipsis, style: const TextStyle(fontSize: 13)),
            )).toList(),
            onChanged: (v) => setState(() => _selectedToAccount = v),
          ),
          const SizedBox(height: 12),
          _fLabel('Amount'),
          const SizedBox(height: 6),
          amtChip,
          const SizedBox(height: 12),
          _fLabel('Notes (optional)'),
          const SizedBox(height: 6),
          _fField(_panelNotesCtrl, 'Notes', Icons.note_outlined, maxLines: 2),
        ]);

      // ── SIMPLE (Interest Income, Other Income, etc.) ──────────────────────
      default:
        return Column(crossAxisAlignment: CrossAxisAlignment.start, children: [
          _fLabel('Amount'),
          const SizedBox(height: 6),
          amtChip,
          const SizedBox(height: 12),
          _fLabel('Date'),
          const SizedBox(height: 6),
          dateChip,
          const SizedBox(height: 12),
          _fLabel('Notes (optional)'),
          const SizedBox(height: 6),
          _fField(_panelNotesCtrl, 'Notes', Icons.note_outlined, maxLines: 2),
        ]);
    }
  }

  // ── Vendor search inside panel ────────────────────────────────────────────

  Widget _buildVendorSearch() {
    final filtered = _vendorSearch.isEmpty
        ? _vendors
        : _vendors.where((v) =>
            v['vendorName']?.toString().toLowerCase()
                .contains(_vendorSearch.toLowerCase()) == true).toList();

    if (_selectedVendor != null) {
      return InkWell(
        onTap: () => setState(() { _selectedVendor = null; _vendorSearch = ''; }),
        child: Container(
          padding: const EdgeInsets.symmetric(horizontal: 12, vertical: 10),
          decoration: BoxDecoration(
            color: _green.withOpacity(0.06),
            border: Border.all(color: _green.withOpacity(0.4)),
            borderRadius: BorderRadius.circular(6),
          ),
          child: Row(children: [
            Icon(Icons.business_outlined, size: 14, color: _green),
            const SizedBox(width: 8),
            Expanded(child: Text(_selectedVendor!['vendorName']?.toString() ?? '',
                style: TextStyle(fontSize: 13, color: _green, fontWeight: FontWeight.w600))),
            Icon(Icons.close, size: 14, color: _green),
          ]),
        ),
      );
    }

    return Column(children: [
      TextField(
        onChanged: (v) => setState(() => _vendorSearch = v),
        decoration: InputDecoration(
          hintText: 'Search vendors...',
          prefixIcon: const Icon(Icons.search, size: 16),
          border: OutlineInputBorder(borderRadius: BorderRadius.circular(6)),
          isDense: true,
          contentPadding: const EdgeInsets.symmetric(horizontal: 10, vertical: 10),
        ),
      ),
      if (_vendorSearch.isNotEmpty) ...[
        const SizedBox(height: 4),
        Container(
          constraints: const BoxConstraints(maxHeight: 140),
          decoration: BoxDecoration(
            border: Border.all(color: const Color(0xFFCBD5E1)),
            borderRadius: BorderRadius.circular(6),
            color: Colors.white,
          ),
          child: filtered.isEmpty
              ? const Padding(padding: EdgeInsets.all(12),
                  child: Text('No vendors found', style: TextStyle(fontSize: 12,
                      color: Color(0xFF7F8C8D))))
              : ListView.builder(
                  shrinkWrap: true,
                  itemCount: filtered.length,
                  itemBuilder: (_, i) => InkWell(
                    onTap: () => setState(() {
                      _selectedVendor = filtered[i];
                      _vendorSearch   = '';
                    }),
                    child: Padding(
                      padding: const EdgeInsets.symmetric(horizontal: 12, vertical: 10),
                      child: Text(filtered[i]['vendorName']?.toString() ?? '',
                          style: const TextStyle(fontSize: 13)),
                    ),
                  ),
                ),
        ),
      ],
    ]);
  }

  // ── Customer search inside panel ──────────────────────────────────────────

  Widget _buildCustomerSearch() {
    final filtered = _customerSearch.isEmpty
        ? _customers
        : _customers.where((c) =>
            c['customerName']?.toString().toLowerCase()
                .contains(_customerSearch.toLowerCase()) == true).toList();

    if (_selectedCustomer != null) {
      return InkWell(
        onTap: () => setState(() { _selectedCustomer = null; _customerSearch = ''; }),
        child: Container(
          padding: const EdgeInsets.symmetric(horizontal: 12, vertical: 10),
          decoration: BoxDecoration(
            color: _green.withOpacity(0.06),
            border: Border.all(color: _green.withOpacity(0.4)),
            borderRadius: BorderRadius.circular(6),
          ),
          child: Row(children: [
            Icon(Icons.person_outline, size: 14, color: _green),
            const SizedBox(width: 8),
            Expanded(child: Text(_selectedCustomer!['customerName']?.toString() ?? '',
                style: TextStyle(fontSize: 13, color: _green, fontWeight: FontWeight.w600))),
            Icon(Icons.close, size: 14, color: _green),
          ]),
        ),
      );
    }

    return Column(children: [
      TextField(
        onChanged: (v) => setState(() => _customerSearch = v),
        decoration: InputDecoration(
          hintText: 'Search customers... (optional)',
          prefixIcon: const Icon(Icons.search, size: 16),
          border: OutlineInputBorder(borderRadius: BorderRadius.circular(6)),
          isDense: true,
          contentPadding: const EdgeInsets.symmetric(horizontal: 10, vertical: 10),
        ),
      ),
      if (_customerSearch.isNotEmpty) ...[
        const SizedBox(height: 4),
        Container(
          constraints: const BoxConstraints(maxHeight: 140),
          decoration: BoxDecoration(
            border: Border.all(color: const Color(0xFFCBD5E1)),
            borderRadius: BorderRadius.circular(6),
            color: Colors.white,
          ),
          child: filtered.isEmpty
              ? const Padding(padding: EdgeInsets.all(12),
                  child: Text('No customers found', style: TextStyle(fontSize: 12,
                      color: Color(0xFF7F8C8D))))
              : ListView.builder(
                  shrinkWrap: true,
                  itemCount: filtered.length,
                  itemBuilder: (_, i) => InkWell(
                    onTap: () => setState(() {
                      _selectedCustomer = filtered[i];
                      _customerSearch   = '';
                    }),
                    child: Padding(
                      padding: const EdgeInsets.symmetric(horizontal: 12, vertical: 10),
                      child: Text(filtered[i]['customerName']?.toString() ?? '',
                          style: const TextStyle(fontSize: 13)),
                    ),
                  ),
                ),
        ),
      ],
    ]);
  }

  // ── Category dropdown ─────────────────────────────────────────────────────

  Widget _buildCatDropdown(List<_Cat> cats, String groupLbl) => Column(children: [
    InkWell(
      onTap: () => setState(() => _catDropOpen = !_catDropOpen),
      child: Container(
        padding: const EdgeInsets.symmetric(horizontal: 12, vertical: 11),
        decoration: BoxDecoration(
          color: Colors.white,
          border: Border.all(
              color: _catDropOpen ? _navyAccent : const Color(0xFFCBD5E1)),
          borderRadius: BorderRadius.only(
            topLeft: const Radius.circular(6), topRight: const Radius.circular(6),
            bottomLeft: Radius.circular(_catDropOpen ? 0 : 6),
            bottomRight: Radius.circular(_catDropOpen ? 0 : 6),
          ),
        ),
        child: Row(children: [
          if (_selectedCat != null) ...[
            Icon(_selectedCat!.icon, color: _selectedCat!.color, size: 16),
            const SizedBox(width: 8),
            Expanded(child: Text(_selectedCat!.label,
                style: const TextStyle(fontSize: 13, color: Color(0xFF2C3E50)))),
          ] else
            Expanded(child: Text('Select $groupLbl Category',
                style: const TextStyle(fontSize: 13, color: Color(0xFF94A3B8)))),
          Icon(_catDropOpen ? Icons.keyboard_arrow_up : Icons.keyboard_arrow_down,
              size: 18, color: const Color(0xFF7F8C8D)),
        ]),
      ),
    ),
    if (_catDropOpen)
      Container(
        decoration: BoxDecoration(
          color: Colors.white,
          border: Border.all(color: _navyAccent),
          borderRadius: const BorderRadius.only(
            bottomLeft: Radius.circular(6), bottomRight: Radius.circular(6)),
          boxShadow: [BoxShadow(color: Colors.black.withOpacity(0.10),
              blurRadius: 12, offset: const Offset(0,4))],
        ),
        child: Column(children: [
          Padding(padding: const EdgeInsets.all(8),
            child: TextField(
              autofocus: true,
              onChanged: (v) => setState(() => _catSearch = v.toLowerCase()),
              decoration: InputDecoration(
                hintText: 'Search',
                prefixIcon: const Icon(Icons.search, size: 15),
                isDense: true, border: OutlineInputBorder(borderRadius: BorderRadius.circular(6)),
                contentPadding: const EdgeInsets.symmetric(horizontal: 10, vertical: 8),
              ),
            )),
          ConstrainedBox(
            constraints: const BoxConstraints(maxHeight: 220),
            child: SingleChildScrollView(
              child: Column(children: cats.where((c) {
                final s = _catSearch;
                return s == null || s.isEmpty || c.label.toLowerCase().contains(s);
              }).map((c) {
                final sel = _selectedCat?.id == c.id;
                return InkWell(
                  onTap: () => setState(() {
                    _selectedCat    = c;
                    _catDropOpen    = false;
                    _catSearch      = null;
                    // Reset panel form fields when category changes
                    _selectedVendor        = null;
                    _selectedCustomer      = null;
                    _selectedToAccount     = null;
                    _selectedExpenseAccount= null;
                    _vendorSearch          = '';
                    _customerSearch        = '';
                    _panelNotesCtrl.clear();
                  }),
                  child: Container(
                    padding: const EdgeInsets.symmetric(horizontal: 14, vertical: 11),
                    color: sel ? _navyAccent.withOpacity(0.07) : Colors.transparent,
                    child: Row(children: [
                      Icon(c.icon, color: sel ? _navyAccent : c.color, size: 16),
                      const SizedBox(width: 10),
                      Expanded(child: Text(c.label, style: TextStyle(fontSize: 13,
                          color: sel ? _navyAccent : const Color(0xFF2C3E50),
                          fontWeight: sel ? FontWeight.w600 : FontWeight.normal))),
                      if (sel) Icon(Icons.check, color: _navyAccent, size: 15),
                    ]),
                  ),
                );
              }).toList()),
            ),
          ),
        ]),
      ),
  ]);

  // ── Field helpers ─────────────────────────────────────────────────────────

  Widget _fLabel(String label) => Text(label,
      style: const TextStyle(fontSize: 12, fontWeight: FontWeight.w600,
          color: Color(0xFF374151)));

  Widget _fField(TextEditingController ctrl, String hint, IconData icon,
      {int maxLines = 1}) =>
      TextField(
        controller: ctrl, maxLines: maxLines,
        decoration: InputDecoration(
          hintText: hint,
          hintStyle: const TextStyle(fontSize: 13, color: Color(0xFF94A3B8)),
          prefixIcon: Icon(icon, size: 16, color: const Color(0xFF7F8C8D)),
          border: OutlineInputBorder(borderRadius: BorderRadius.circular(6)),
          isDense: true,
          contentPadding: const EdgeInsets.symmetric(horizontal: 10, vertical: 12),
        ),
      );

  // ── Dialog launchers ──────────────────────────────────────────────────────

  void _showImport() => showDialog(
    context: context, barrierDismissible: false,
    builder: (_) => BulkImportBankStatementDialog(
      accountId:        widget.accountId,
      accountName:      widget.accountName,
      onImportComplete: () { _loadAll(); _showSuccess('Statement imported'); },
    ),
  );

  void _showRecordDeposit() => showDialog(
    context: context,
    builder: (_) => RecordDepositDialog(
      accountId:   widget.accountId,
      accountName: widget.accountName,
      onSaved:     () { _loadAll(); _showSuccess('Deposit recorded'); },
    ),
  );

  void _showRules() => Navigator.push(context, MaterialPageRoute(
    builder: (_) => TransactionRulesScreen(
        accountId: widget.accountId, accountName: widget.accountName),
  )).then((_) => _loadAll());

  // ── Snackbars ─────────────────────────────────────────────────────────────

  void _showSuccess(String msg) {
    if (!mounted) return;
    ScaffoldMessenger.of(context).showSnackBar(SnackBar(
      content: Text(msg), backgroundColor: _green,
      behavior: SnackBarBehavior.floating,
      shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(10)),
      duration: const Duration(seconds: 2),
    ));
  }

  void _showError(String msg) {
    if (!mounted) return;
    ScaffoldMessenger.of(context).showSnackBar(SnackBar(
      content: Text(msg), backgroundColor: _red,
      behavior: SnackBarBehavior.floating,
      shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(10)),
    ));
  }

  DateTime _parseDate(dynamic d) {
    if (d == null) return DateTime.now();
    try { return DateTime.parse(d.toString()); } catch (_) { return DateTime.now(); }
  }
}