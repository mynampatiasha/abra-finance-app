  // ── Build menu widgets ────────────────────────────────────────────────────
  List<Widget> _buildMenuWidgets({required bool showFull, required bool isDrawer}) {
    final items   = _visibleMenuItems;
    final widgets = <Widget>[];

    for (final item in items) {
      final isSelected = _currentRoute == item.route ||
          // Highlight parent when a sub-route is active
          (_currentRoute.startsWith('${item.route}/') && item.isExpandable);
      final isExpanded = _expandedSections[item.route] ?? false;

      widgets.add(
        _SidebarItem(
          item:       item,
          isSelected: isSelected,
          isExpanded: isExpanded,
          showFull:   showFull,
          onTap: () {
            if (item.isExpandable) {
              setState(() {
                _expandedSections[item.route] = !isExpanded;
              });
            } else {
              if (isDrawer) Navigator.pop(context);
              _handleTopLevelNavigation(item.route, item.label);
            }
          },
        ),
      );

      // Sub-items
      if (item.isExpandable && isExpanded && showFull) {
        for (final sub in item.subItems ?? []) {
          widgets.add(
            _SubSidebarItem(
              subItem:    sub,
              isSelected: _currentRoute == sub.route,
              onTap: () {
                if (isDrawer) Navigator.pop(context);
                _navigateInline(sub.route, sub.label);
              },
            ),
          );
        }
      }
    }
    return widgets;
  }

  // ── Handle top-level navigation (non-expandable items) ───────────────────
  void _handleTopLevelNavigation(String route, String label) {
    switch (route) {
      case 'home':
        _goToDashboard();
        break;
      case 'my_profile':
        // Profile stays as a push (full-screen)
        _openProfile();
        break;
      default:
        // All other top-level items navigate inline
        _navigateInline(route, label);
    }
  }

  Widget _buildDrawer() {
    return Drawer(child: _buildSidebarContent(isDrawer: true));
  }
}

// =============================================================================
// _EmbeddedPage
// =============================================================================
// Wraps any sub-page widget and suppresses its internal Scaffold AppBar
// using a Theme override — so ZERO changes are needed in sub-page files.
//
// How it works:
//   • appBarTheme(toolbarHeight: 0, elevation: 0) collapses the AppBar
//     to zero height without removing it, so no layout errors occur.
//   • The sub-page's Scaffold body still renders correctly at full height.
// =============================================================================
class _EmbeddedPage extends StatelessWidget {
  final Widget child;

  const _EmbeddedPage({required this.child});

  @override
  Widget build(BuildContext context) {
    return Theme(
      data: Theme.of(context).copyWith(
        appBarTheme: Theme.of(context).appBarTheme.copyWith(
          // Collapse the AppBar height to zero — hides it completely
          toolbarHeight: 0,
          elevation: 0,
          shadowColor: Colors.transparent,
          surfaceTintColor: Colors.transparent,
        ),
      ),
      child: child,
    );
  }
}

