        return _EmbeddedPage(child: const ItemsBilling());

      // ── Sales ─────────────────────────────────────────────────────────────
      case 'sales/customers':
        return _EmbeddedPage(child: const CustomersListPage());
      case 'sales/invoices':
        return _EmbeddedPage(child: const InvoicesListPage());
      case 'sales/recurring_invoices':
        return _EmbeddedPage(child: const RecurringInvoicesListPage());
      case 'sales/payments_received':
        return _EmbeddedPage(child: const PaymentsReceivedPage());
      case 'sales/credit_notes':
        return _EmbeddedPage(child: const CreditNotesListPage());
      case 'sales/quotes':
        return _EmbeddedPage(child: const QuotesListPage());
      case 'sales/orders':
        return _EmbeddedPage(child: const SalesOrdersListPage());
      case 'sales/delivery_challans':
